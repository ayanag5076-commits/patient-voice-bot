# Who to call. The bot dials TARGET_NUMBER only if it also appears in ALLOWED_NUMBERS.
# Only call a line you own or have written permission to test. E.164 format.
TARGET_NUMBER=+15555550100
ALLOWED_NUMBERS=+15555550100

# What kind of practice you're calling (the bundled scenarios assume orthopedics)
CLINIC_DESCRIPTION=an orthopedic practice (bones, joints, muscles, sports injuries, physical therapy)

# LiveKit Cloud project (cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Outbound SIP trunk created with `lk sip outbound create outbound-trunk.json` (looks like ST_xxxx)
SIP_OUTBOUND_TRUNK_ID=

# Pipeline providers
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
# Optional: a Cartesia voice ID from their voice library (plugin default is used if blank)
CARTESIA_VOICE_ID=
LLM_MODEL=gpt-6-luna
REVIEW_MODEL=gpt-6.1-sol

# Twilio (for pulling the dual-channel trunk recordings)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A test patient registered in the system you're testing (used for "existing patient" scenarios)
PATIENT_NAME=
PATIENT_DOB=
PATIENT_PHONE=

MAX_CALL_SECONDS=240
